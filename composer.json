{
  "$schema": "https://raw.githubusercontent.com/composer/composer/main/res/composer-schema.json",
  "name": "mosuka/litsea",
  "description": "PHP extension for Litsea, a compact word segmentation and POS tagging library (no embedded models)",
  "type": "php-ext",
  "license": "MIT",
  "homepage": "https://github.com/mosuka/litsea",
  "keywords": ["word", "segmentation", "tokenizer", "pos", "nlp", "extension"],
  "support": {
    "issues": "https://github.com/mosuka/litsea/issues",
    "source": "https://github.com/mosuka/litsea",
    "docs": "https://mosuka.github.io/litsea/"
  },
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0 || ^12.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Litsea\\Tests\\": "litsea-php/tests/",
      "Litsea\\Tools\\": "litsea-php/tools/"
    }
  },
  "php-ext": {
    "extension-name": "litsea",
    "build-path": "litsea-php",
    "support-zts": true,
    "support-nts": true,
    "download-url-method": ["pre-packaged-binary", "composer-default"],
    "os-families-exclude": ["windows"]
  },
  "config": {
    "sort-packages": true
  }
}
